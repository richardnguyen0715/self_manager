# ──────────────────────────────────────────────────────────────────────────────
# manage-my-life – consolidated environment variables for docker-compose
#
# Copy this file to .env and fill in every value marked CHANGE_ME.
# Lines marked "optional" have sane defaults and can be left as-is locally.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=mml
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=manage_my_life

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Backend / Rust ────────────────────────────────────────────────────────────
# Constructed automatically from the postgres/redis vars above in compose.
# Override here only if pointing to an external DB/Redis.
# DATABASE_URL=postgres://mml:password@postgres:5432/manage_my_life
# REDIS_URL=redis://:password@redis:6379

JWT_SECRET=CHANGE_ME_at_least_64_chars_random_secret_here_use_openssl_rand
# JWT token lifetimes (seconds). Defaults: 15 min access, 30 day refresh.
# Must match the env var names in backend/src/shared/config.rs
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# ── Cloudflare R2 (object storage) ───────────────────────────────────────────
# Leave blank to disable file upload features locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Sentry (error tracking) ───────────────────────────────────────────────────
# Leave blank to disable Sentry reporting locally.
SENTRY_DSN=

# ── Frontend / Next.js ────────────────────────────────────────────────────────
# Public vars are baked into the Next.js bundle at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty = any origin (dev only; set in production).
CORS_ORIGINS=
