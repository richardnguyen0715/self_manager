# ── Production deployment (docker/docker-compose.prod.yml) ──────────────────
# Copy to .env on the server and fill in secrets:  cp .env.prod.example .env

# Public domain (DNS A/AAAA record must point at this server)
DOMAIN=app.example.com
# Email for Let's Encrypt certificate notices
TLS_EMAIL=you@example.com

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=mml
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=manage_my_life

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_a_64_byte_random_hex_secret_at_least_64_chars_long
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# ── Misc ────────────────────────────────────────────────────────────────────
RUST_LOG=manage_my_life=info,tower_http=warn

# ── Server mode (docker-compose.server.yml: Cloudflare Tunnel + host nginx) ──
# Loopback ports the host nginx vhost proxies to (must be free on the server).
WEB_PORT=3100
API_PORT=3101

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.example.com
