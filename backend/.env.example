# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/manage_my_life

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_bytes_long_for_hs512

# Token TTL (seconds)
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Cloudflare R2 (optional) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=manage-my-life
R2_PUBLIC_URL=

# ── Resend email (optional) ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Misc ─────────────────────────────────────────────────────────────────────
RUST_LOG=manage_my_life=debug,tower_http=debug,sqlx=warn

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Empty = any origin (dev only).
CORS_ORIGINS=
