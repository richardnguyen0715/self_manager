  "query": "\n        UPDATE habits\n        SET\n            name            = $3,\n            description     = $4,\n            habit_type      = $5,\n            target_value    = $6::NUMERIC,\n            frequency       = $7,\n            frequency_days  = $8,\n            reminder_time   = $9,\n            color           = $10,\n            icon            = $11,\n            archived        = $12,\n            position        = $13,\n            updated_at      = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING\n            id,\n            user_id,\n            name,\n            description,\n            habit_type      AS \"habit_type: HabitType\",\n            target_value::DOUBLE PRECISION AS \"target_value!: f64\",\n            frequency       AS \"frequency: HabitFrequency\",\n            frequency_days,\n            reminder_time,\n            color,\n            icon,\n            archived,\n            position,\n            created_at,\n            updated_at\n        ",
