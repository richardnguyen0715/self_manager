  "query": "\n                SELECT\n                    id, user_id, goal_id, title, description,\n                    status::text AS \"status!\",\n                    color, position, created_at, updated_at\n                FROM initiatives\n                WHERE user_id = $1\n                ORDER BY position ASC, created_at ASC\n                LIMIT $2 OFFSET $3\n                ",
