{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id, user_id, goal_id, title, description,\n                    status::text AS \"status!\",\n                    color, position, created_at, updated_at\n                FROM initiatives\n                WHERE user_id = $1\n                  AND goal_id = $2\n                  AND status::text = $3\n                ORDER BY position ASC, created_at ASC\n                LIMIT $4 OFFSET $5\n                ",
