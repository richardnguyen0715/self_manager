  "query": "\n        UPDATE initiatives\n        SET\n            goal_id     = $3,\n            title       = $4,\n            description = $5,\n            status      = ($6::text)::initiative_status,\n            color       = $7,\n            position    = $8,\n            updated_at  = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING\n            id, user_id, goal_id, title, description,\n            status::text AS \"status!\",\n            color, position, created_at, updated_at\n        ",
