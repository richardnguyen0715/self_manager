  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            user_id,\n            project_id,\n            name,\n            color,\n            position,\n            wip_limit,\n            mapped_status::text AS \"mapped_status?\",\n            created_at,\n            updated_at\n        FROM board_columns\n        WHERE user_id = $1\n          AND ($2::uuid IS NULL AND project_id IS NULL\n               OR project_id = $2)\n        ORDER BY position ASC, created_at ASC\n        ",
