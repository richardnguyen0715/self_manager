{
  "db_name": "PostgreSQL",
  "query": "SELECT\n               t.id,\n               t.user_id,\n               t.project_id,\n               t.title,\n               t.description,\n               t.priority    AS \"priority: TaskPriority\",\n               t.status      AS \"status: TaskStatus\",\n               t.due_date,\n               t.start_date,\n               t.estimated_time,\n               t.actual_time,\n               t.recurrence_rule,\n               t.completed_at,\n               t.position,\n               t.created_at,\n               t.updated_at\n           FROM tasks t\n           WHERE t.user_id = $1\n             AND t.deleted_at IS NULL\n             AND ($2::uuid    IS NULL OR t.project_id = $2)\n             AND ($3::task_status IS NULL OR t.status  = $3)\n             AND ($4::task_priority IS NULL OR t.priority = $4)\n             AND ($5::timestamptz IS NULL OR t.due_date <= $5)\n             AND ($6::timestamptz IS NULL OR t.due_date >= $6)\n             AND ($7::uuid IS NULL OR EXISTS (\n                     SELECT 1 FROM task_tags tt\n                     WHERE tt.task_id = t.id AND tt.tag_id = $7\n                 ))\n           ORDER BY t.position ASC, t.created_at DESC\n           LIMIT $8 OFFSET $9",
