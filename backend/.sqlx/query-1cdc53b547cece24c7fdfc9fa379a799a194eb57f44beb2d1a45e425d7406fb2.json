{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE epics\n        SET\n            initiative_id = $3,\n            title         = $4,\n            description   = $5,\n            status        = ($6::text)::epic_status,\n            start_date    = $7,\n            due_date      = $8,\n            color         = $9,\n            position      = $10,\n            updated_at    = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING\n            id, user_id, initiative_id, title, description,\n            status::text AS \"status!\",\n            start_date, due_date, color, position, created_at, updated_at\n        ",
