  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id, user_id, initiative_id, title, description,\n                    status::text AS \"status!\",\n                    start_date, due_date, color, position, created_at, updated_at\n                FROM epics\n                WHERE user_id = $1\n                  AND initiative_id = $2\n                ORDER BY position ASC, created_at ASC\n                LIMIT $3 OFFSET $4\n                ",
