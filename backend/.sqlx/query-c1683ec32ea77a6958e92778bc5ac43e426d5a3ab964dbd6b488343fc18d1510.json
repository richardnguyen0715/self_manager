{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            user_id,\n            goal_id,\n            name,\n            description,\n            color,\n            deadline,\n            status  AS \"status: ProjectStatus\",\n            position,\n            organization_id,\n            deleted_at,\n            key,\n            estimate_system,\n            created_at,\n            updated_at\n        FROM projects\n        WHERE user_id = $1\n          AND deleted_at IS NOT NULL\n        ORDER BY deleted_at DESC\n        ",
