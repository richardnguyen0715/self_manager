  "query": "SELECT\n               id,\n               title,\n               start_time,\n               end_time,\n               all_day,\n               location,\n               color\n           FROM calendar_events\n           WHERE user_id = $1\n             AND start_time <= $3\n             AND end_time   >= $2\n           ORDER BY start_time ASC, all_day DESC",
