{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, space_id, title, kind, icon\n        FROM pages\n        WHERE user_id = $1\n          AND ($2::uuid IS NULL OR space_id = $2)\n          AND title % $3\n        ORDER BY similarity(title, $3) DESC\n        LIMIT 50\n        ",
