  "query": "\n        UPDATE users\n        SET\n            display_name = COALESCE($2, display_name),\n            timezone     = COALESCE($3, timezone),\n            updated_at   = NOW()\n        WHERE id = $1\n        RETURNING id, email, password_hash, display_name,\n                  avatar_url, timezone, created_at, updated_at\n        ",
