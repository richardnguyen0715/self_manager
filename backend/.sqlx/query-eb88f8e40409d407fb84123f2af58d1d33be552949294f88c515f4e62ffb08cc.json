  "db_name": "PostgreSQL",
  "query": "\n        UPDATE work_items\n        SET\n            project_id      = $3,\n            epic_id         = $4,\n            sprint_id       = $5,\n            type            = ($6::text)::work_item_type,\n            title           = $7,\n            description     = $8,\n            status          = ($9::text)::work_item_status,\n            priority        = ($10::text)::task_priority,\n            story_points    = $11,\n            position        = $12,\n            due_date        = $13,\n            recurrence_rule = $14,\n            completed_at    = $15,\n            updated_at      = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING\n            id, user_id, project_id, epic_id, sprint_id,\n            type::text     AS \"item_type!\",\n            title, description,\n            status::text   AS \"status!\",\n            priority::text AS \"priority!\",\n            story_points, position,\n            due_date, recurrence_rule, completed_at,\n            column_id,\n            created_at, updated_at\n        ",
