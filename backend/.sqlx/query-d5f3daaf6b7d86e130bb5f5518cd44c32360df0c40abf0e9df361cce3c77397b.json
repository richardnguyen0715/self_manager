  "query": "SELECT a.id, a.field, a.old_value, a.new_value, a.created_at\n           FROM work_item_activity a\n           JOIN work_items wi ON wi.id = a.work_item_id\n           WHERE a.work_item_id = $1 AND wi.user_id = $2\n           ORDER BY a.created_at DESC\n           LIMIT 200",
