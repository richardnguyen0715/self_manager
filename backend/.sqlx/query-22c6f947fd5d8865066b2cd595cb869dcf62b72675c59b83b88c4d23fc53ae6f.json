{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.work_item_id,\n            c.user_id,\n            u.display_name AS \"author_name!\",\n            c.body,\n            c.created_at\n        FROM work_item_comments c\n        JOIN users u ON u.id = c.user_id\n        WHERE c.work_item_id = $1\n        ORDER BY c.created_at ASC\n        ",
