{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            habit_id,\n            user_id,\n            log_date,\n            value::DOUBLE PRECISION AS \"value!: f64\",\n            completed,\n            note,\n            created_at,\n            updated_at\n        FROM habit_logs\n        WHERE habit_id = $1\n          AND user_id  = $2\n          AND log_date BETWEEN $3 AND $4\n        ORDER BY log_date DESC\n        ",
