  "query": "\n        SELECT id, parent_id, title, icon, public_slug, position\n        FROM pages\n        WHERE parent_id = $1\n          AND is_public = true\n          AND status = 'published'\n          AND is_template = false\n        ORDER BY position ASC, created_at ASC\n        ",
