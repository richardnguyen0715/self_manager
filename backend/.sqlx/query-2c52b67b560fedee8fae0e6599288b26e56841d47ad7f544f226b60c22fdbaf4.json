  "query": "UPDATE subtasks SET\n               title    = COALESCE($3, title),\n               is_done  = COALESCE($4, is_done),\n               position = COALESCE($5, position)\n           WHERE id = $2 AND task_id = $1\n           RETURNING id, task_id, title, is_done, position, created_at, updated_at",
