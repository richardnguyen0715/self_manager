  "query": "\n        UPDATE calendar_events\n        SET    title           = $1,\n               description     = $2,\n               start_time      = $3,\n               end_time        = $4,\n               all_day         = $5,\n               location        = $6,\n               color           = $7,\n               recurrence_rule = $8,\n               updated_at      = now()\n        WHERE  id      = $9\n          AND  user_id = $10\n        RETURNING id, user_id, title, description,\n                  start_time, end_time, all_day,\n                  location, color, recurrence_rule,\n                  created_at, updated_at\n        ",
