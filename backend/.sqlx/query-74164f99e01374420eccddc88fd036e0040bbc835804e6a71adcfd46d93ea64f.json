  "query": "\n        SELECT\n            id,\n            title,\n            icon,\n            cover_url,\n            content AS \"content: serde_json::Value\",\n            updated_at\n        FROM pages\n        WHERE public_slug = $1\n          AND is_public   = true\n          AND status      = 'published'\n          AND is_template = false\n        ",
