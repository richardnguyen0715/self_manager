  "query": "SELECT\n               id,\n               user_id,\n               project_id,\n               title,\n               description,\n               priority    AS \"priority: TaskPriority\",\n               status      AS \"status: TaskStatus\",\n               due_date,\n               start_date,\n               estimated_time,\n               actual_time,\n               recurrence_rule,\n               completed_at,\n               position,\n               created_at,\n               updated_at\n           FROM tasks\n           WHERE id = $1 AND user_id = $2 AND deleted_at IS NULL",
