  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            stat_date,\n            tasks_completed,\n            tasks_created,\n            focus_minutes,\n            habit_completion_rate::float8 AS \"habit_completion_rate!: f64\",\n            pomodoro_sessions\n        FROM   daily_stats\n        WHERE  user_id   = $1\n          AND  stat_date BETWEEN $2 AND $3\n        ORDER BY stat_date ASC\n        ",
