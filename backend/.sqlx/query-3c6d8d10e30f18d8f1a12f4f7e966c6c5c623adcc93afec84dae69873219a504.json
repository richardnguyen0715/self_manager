{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            user_id,\n            goal_id,\n            name,\n            description,\n            color,\n            deadline,\n            status  AS \"status: ProjectStatus\",\n            position,\n            created_at,\n            updated_at\n        FROM projects\n        WHERE user_id = $1\n          AND ($2::project_status IS NULL OR status = $2)\n          AND ($3::uuid IS NULL OR goal_id = $3)\n        ORDER BY position ASC, created_at ASC\n        ",
