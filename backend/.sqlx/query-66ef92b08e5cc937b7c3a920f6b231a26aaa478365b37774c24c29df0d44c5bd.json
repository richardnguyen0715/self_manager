{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE organizations SET\n            name        = COALESCE($3, name),\n            description = COALESCE($4, description),\n            color       = COALESCE($5, color),\n            position    = COALESCE($6, position),\n            updated_at  = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING\n            id,\n            user_id,\n            name,\n            description,\n            color,\n            position,\n            created_at,\n            updated_at\n        ",
