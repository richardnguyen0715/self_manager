  "query": "\n            UPDATE sprint_reviews\n            SET\n                planned_points   = $3,\n                completed_points = $4,\n                velocity         = $5::float8,\n                summary          = $6,\n                updated_at       = now()\n            WHERE id = $1 AND user_id = $2\n            RETURNING\n                id,\n                user_id,\n                sprint_id,\n                planned_points,\n                completed_points,\n                velocity::float8 AS \"velocity!: f64\",\n                summary,\n                created_at,\n                updated_at\n            ",
