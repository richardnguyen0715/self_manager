  "query": "\n        UPDATE goals\n        SET\n            title       = $3,\n            description = $4,\n            target_date = $5,\n            status      = ($6::text)::goal_status,\n            color       = $7,\n            position    = $8,\n            updated_at  = now()\n        WHERE id = $1 AND user_id = $2\n        RETURNING\n            id, user_id, title, description,\n            target_date, status::text AS \"status!\",\n            color, position, created_at, updated_at\n        ",
